    { "@type": "CollegeOrUniversity", name: "Liberty University" },
    { "@type": "CollegeOrUniversity", name: "Eastern Nazarene College" },
  ],
  knowsAbout: [
    "Go-to-market strategy",
    "Demand generation",
    "PPC",
    "SEO",
    "Answer engine optimization (AEO)",
    "Channel marketing mix",
    "Marketing operations",
    "OKRs",
    "Product prototyping",
    "Data visualization",
    "B2B SaaS marketing",
  ],
};

---

<Layout
  navLinks={[
    { text: "Execution", href: "#execution" },
    { text: "Experience", href: "#experience" },
    { text: "Results", href: "#results" },
    { text: "Quotes", href: "#testimonials" },
    { text: "AI", href: "#ai" },
    { text: "About", href: "#about" },
  ]}
  ctaButton={{
    text: "Schedule Meeting",
    href: "https://calendly.com/stephen-krezzo/connect-with-stephen-30-mins",
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <!-- Hero -->
  <section class="relative pt-12 pb-24 md:pt-16 md:pb-32 overflow-hidden">
    <div class="max-w-5xl mx-auto px-6 relative">
      <div class="lg:grid lg:grid-cols-[1fr_14rem] lg:gap-16 lg:items-center">
        <div>
          <p
            class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-8"
          >
            GTM Executive & Growth Marketer
          </p>

          <h1
            class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tightest text-ink leading-none"
          >
            Drive engagement.<br />
            Increase pipeline.<br />
            <span class="text-gradient">Grow revenue.</span>
          </h1>

          <p class="max-w-2xl text-lg text-neutral mt-10 leading-relaxed">
            Builder of full-funnel GTM engines for B2B SaaS companies: awareness that
            fills the top, offers and nurture that move deals through the middle,
            and the tools and training that help closers close. Pipeline growth
            without extra overhead, and without the noise. 15+ years of
            experience. Four acquisitions. One IPO. Advanced AI operator.
          </p>

          <div class="mt-12 flex flex-wrap items-center gap-4">
            <a
              class="inline-block rounded-full bg-gradient px-8 py-4 text-sm font-medium text-[#fff] hover:opacity-90 transition-opacity"
              href="https://calendly.com/stephen-krezzo/connect-with-stephen-30-mins"
              target="_blank"
              rel="noopener noreferrer"
            >
              Schedule Meeting
            </a>
            <a
              class="inline-block rounded-full bg-ink px-8 py-4 text-sm font-medium text-[#fff] hover:bg-ink/80 transition-colors"
              href={resumeUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Download Resume
            </a>
          </div>
        </div>

        <div class="mt-16 lg:mt-0">
          <p
            class="text-xs uppercase tracking-[0.2em] text-neutral/50 font-medium mb-6"
          >
            Companies grown along the way
          </p>
          <div
            class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-2 gap-x-8 gap-y-8 items-center"
          >
            <img
              src="/eloqua_logo.png"
              alt="Eloqua"
              class="h-8 w-auto object-contain brightness-0 opacity-40"
            />
            <img
              src="/aras_logo.png"
              alt="Aras"
              class="h-8 w-auto object-contain brightness-0 opacity-40"
            />
            <img
              src="/ti_logo.webp"
              alt="Thought Industries"
              class="h-7 w-auto object-contain brightness-0 opacity-40"
            />
            <img
              src="/form_logo.png"
              alt="Form.com"
              class="h-8 w-auto object-contain brightness-0 opacity-40"
            />
            <img
              src="/krezzo_logo.png"
              alt="Krezzo"
              class="h-7 w-auto object-contain brightness-0 opacity-40"
            />
            <img
              src="/checkit_logo.svg"
              alt="Checkit"
              class="h-6 w-auto object-contain brightness-0 opacity-40"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Execution -->
  <section id="execution" class="py-24 bg-surface">
    <span id="problems" class="sr-only"></span>
    <span id="solutions" class="sr-only"></span>
    <div class="max-w-5xl mx-auto px-6">
      <p
        class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-4 reveal"
      >
        End-to-end coverage
      </p>
      <h2
        class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-4 reveal"
      >
        Full-Funnel Execution
      </h2>
      <p class="text-neutral max-w-2xl mb-16 reveal">
        Twelve areas of execution across every stage of the funnel, plus the
        operations that hold it all together.
      </p>

      <div>
        {
          funnelGroups.map((group, g) => (
            <div class="grid grid-cols-1 lg:grid-cols-[15rem_1fr] gap-8 lg:gap-12 py-12 border-t border-ink/10 first:border-t-0 first:pt-0 last:pb-0">
              <div class="reveal">
                <div
                  class={`h-2 rounded-full mb-5 ${
                    group.stage === "Operational"
                      ? "w-full bg-ink/15"
                      : ["w-full bg-gradient", "w-2/3 bg-gradient", "w-1/3 bg-gradient"][g]
                  }`}
                  aria-hidden="true"
                />
                <h3 class="font-serif text-xl font-bold tracking-tight text-ink">
                  {group.stage}
                </h3>
                <p class="text-sm text-neutral/70 mt-1">{group.tagline}</p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-8">
                {group.items.map((item) => (
                  <div class="reveal">
                    <div class="flex items-center gap-3 mb-3">
                      <svg class="w-6 h-6 text-violet-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <Fragment set:html={item.icon} />
                      </svg>
                    </div>
                    <h4 class="text-base font-bold text-ink mb-2">{item.title}</h4>
                    <p class="text-sm text-neutral leading-relaxed">
                      {item.description}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Experience -->
  <Experience />

  <!-- Results -->
  <section id="results" class="py-24 bg-gradient-to-br from-violet-50/70 via-white to-pink-50/70">
    <div class="max-w-5xl mx-auto px-6">
      <p
        class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-4 reveal"
      >
        By the numbers
      </p>
      <h2
        class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-16 reveal"
      >
        Results &amp; Highlights
      </h2>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12 reveal">
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">15+</p>
          <p class="text-sm text-neutral mt-2">Years in B2B SaaS</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">4</p>
          <p class="text-sm text-neutral mt-2">Acquisitions & exits</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight whitespace-nowrap">$60M+</p>
          <p class="text-sm text-neutral mt-2">Most pipeline generated from scratch (Thought Industries)</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">$5M+</p>
          <p class="text-sm text-neutral mt-2">Pipeline from most recent "senior living" campaign (Checkit)</p>
        </div>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12 mt-12 pt-12 border-t border-ink/10 reveal">
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">20</p>
          <p class="text-sm text-neutral mt-2">Most people managed (Form.com)</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">$2.5M</p>
          <p class="text-sm text-neutral mt-2">Highest budget managed (Form.com)</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">80%</p>
          <p class="text-sm text-neutral mt-2">Revenue from marketing (Thought Industries)</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">$530K</p>
          <p class="text-sm text-neutral mt-2">Raised as founder (Krezzo)</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Proof -->
  <section id="testimonials" class="py-24 bg-surface">
    <div class="max-w-5xl mx-auto px-6">
      <p
        class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-4 reveal"
      >
        What others say
      </p>
      <h2
        class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-16 reveal"
      >
        Quotable Quotes from Peers
      </h2>

      <div class="space-y-16 md:space-y-20">
        {
          testimonials.map((t) => (
            <figure class="reveal max-w-3xl">
              <blockquote class="font-serif text-lg md:text-xl text-ink leading-relaxed tracking-tight">
                &ldquo;{t.quote}&rdquo;
              </blockquote>
              <figcaption class="mt-6">
                <div class="h-0.5 w-10 bg-gradient mb-3" aria-hidden="true" />
                <div class="flex items-center gap-3">
                  <img
                    src={t.image}
                    alt={t.name}
                    width="40"
                    height="40"
                    loading="lazy"
                    class="h-10 w-10 rounded-lg object-cover"
                  />
                  <div>
                    <p class="text-ink font-medium text-sm">{t.name}</p>
                    <p class="text-neutral/60 text-xs mt-0.5">{t.title}</p>
                  </div>
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- AI Operator -->
  <section id="ai" class="py-24 bg-gradient-to-br from-pink-50/70 via-white to-violet-50/70">
    <div class="max-w-5xl mx-auto px-6">
      <p
        class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-4 reveal"
      >
        Build, connect, ship
      </p>
      <h2
        class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-4 reveal"
      >
        Building, Experimenting, and Shipping Faster with AI
      </h2>
      <p class="text-neutral max-w-2xl mb-16 reveal">
        Most executives talk about AI. This is building and deploying with it:
        140+ repositories of shipped applications, prototypes, and experiments,
        built with APIs, MCP integrations, and data visualization, taking ideas
        from prototype to production. A sampling:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-14">
        {
          aiBuilds.map((item) => (
            <div class="reveal flex items-start gap-4 py-5 border-t border-ink/10">
              <svg
                class="w-5 h-5 text-violet-500 shrink-0 mt-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
              >
                <Fragment set:html={item.icon} />
              </svg>
              <div>
                <h3 class="text-base font-bold text-ink">
                  {item.title}
                  {item.preview && (
                    <span class="group/preview relative inline-block align-middle ml-1.5">
                      <svg
                        class="w-4 h-4 text-neutral/40 group-hover/preview:text-violet-500 cursor-help transition-colors"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        aria-label={`Preview of ${item.title}`}
                        role="img"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
                        />
                      </svg>
                      <img
                        src={item.preview}
                        alt={`${item.title} screenshot`}
                        loading="lazy"
                        class="pointer-events-none invisible opacity-0 group-hover/preview:visible group-hover/preview:opacity-100 transition-opacity duration-150 absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-80 max-w-[80vw] max-h-96 object-contain rounded-lg shadow-2xl ring-1 ring-ink/10 bg-white z-50"
                      />
                    </span>
                  )}
                </h3>
                <p class="text-sm text-neutral leading-relaxed mt-1">{item.body}</p>
              </div>
            </div>
          ))
        }
      </div>

      <p class="text-sm text-neutral/70 italic mt-12 reveal">
        *Links and demos to functioning products and prototypes available upon
        request.
      </p>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="py-24">
    <div class="max-w-5xl mx-auto px-6">
      <h2
        class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-12 reveal"
      >
        About Stephen
      </h2>

      <div class="flex flex-col md:flex-row gap-12 items-start reveal">
        <div class="flex-1 space-y-6">
          <p class="text-lg text-neutral leading-relaxed">
            With 15+ years in B2B tech and SaaS, Stephen has led marketing
            through multiple growth stages, from first marketing hire to
            managing global teams and multi-million dollar budgets. He has
            been part of four acquisitions and an IPO, and is an advanced AI
            operator who builds with these tools daily. He currently leads
            global marketing at Checkit.
          </p>
          <p class="text-lg text-neutral leading-relaxed">
            Stephen holds an MBA in International Business from Liberty
            University and a B.A. in Communications from ENC in Boston.
          </p>
          <p class="text-lg text-neutral leading-relaxed">
            He lives in Palm Harbor, FL with his wife Whitney and their four
            girls, and enjoys golfing, going to the beach, and traveling to
            new places.
          </p>
        </div>
        <div class="flex-shrink-0">
          <img
            class="rounded-2xl object-cover w-64 h-64"
            src="/stephen_newman.jpeg"
            alt="Stephen Newman"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-24 md:py-32 bg-ink overflow-hidden">
    <!-- Echo of the funnel motif, oversized and faint -->
    <div
      class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center gap-5 opacity-10 pointer-events-none"
      aria-hidden="true"
    >
      <div class="h-6 w-[42rem] max-w-[90vw] rounded-full bg-gradient"></div>
      <div class="h-6 w-[30rem] max-w-[70vw] rounded-full bg-gradient"></div>
      <div class="h-6 w-80 max-w-[50vw] rounded-full bg-gradient"></div>
      <div class="h-6 w-40 rounded-full bg-gradient"></div>
    </div>

    <div class="max-w-5xl mx-auto px-6 text-center relative">
      <h2 class="font-serif text-4xl md:text-5xl font-bold text-white mb-6">
        Let's build together.
      </h2>
      <p class="text-lg text-slate-300 mb-10 max-w-xl mx-auto">
        Let's drive engagement, increase pipeline, and grow revenue. Or grab
        the resume first.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          class="inline-block rounded-full bg-gradient px-10 py-5 text-sm font-medium text-[#fff] hover:opacity-90 transition-opacity"
          href="https://calendly.com/stephen-krezzo/connect-with-stephen-30-mins"
          target="_blank"
          rel="noopener noreferrer"
        >
          Schedule Meeting
        </a>
        <a
          class="inline-block rounded-full border border-white/30 px-10 py-5 text-sm font-medium text-[#fff] hover:border-white/60 transition-colors"
          href={resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Download Resume
        </a>
      </div>
    </div>
  </section>
</Layout>
