---
import Layout from "../layouts/Layout.astro";
import Experience from "../components/Experience.astro";
import "../styles/global.css";

// Problems and solutions are mirrored 1:1 (same order, same icon, same pair number).
// Ordered most strategic to most tactical.
const pairs = [
  {
