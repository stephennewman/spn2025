---
import Layout from "../layouts/Layout.astro";
import Experience from "../components/Experience.astro";
import "../styles/global.css";

// Problems and solutions are mirrored 1:1 (same order, same icon, same pair number).
const pairs = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />`,
    problem: {
      title: "Invisible in Search & AI Answers",
      description:
        "Your buyers are searching Google and asking ChatGPT, and they're finding your competitors. Paid spend leaks, organic is flat, and AI engines don't know you exist.",
    },
    solution: {
      title: "Digital Marketing Management",
      description:
        "Hands-on PPC, SEO, and AEO programs that put you in front of buyers wherever they look: search engines and AI answers alike.",
    },
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />`,
    problem: {
      title: "Miscalibrated Channel Mix",
      description:
        "You're spread across a dozen channels with no idea which ones actually produce pipeline. Spend follows habit, not signal.",
    },
    solution: {
      title: "Channel Mix Calibration",
      description:
        "Rebalance paid search, social, events (regional, conferences, digital), partners, outbound, inbound, podcasts, print, and web, weighted by what actually converts.",
    },
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />`,
    problem: {
      title: "Customer Interest Dies in Slide Decks",
      description:
        "Prospects tell you exactly what they want, but the ideas stall somewhere between the sales call and the roadmap. Nothing ships.",
    },
    solution: {
      title: "Product Prototyping",
      description:
        "Turn customer interest into working prototypes and product deliverables: fast, testable, and ready to put in front of buyers.",
    },
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />`,
    problem: {
      title: "Disconnected Systems, Gut-Feel Decisions",
      description:
        "Your data lives in ten tools that don't talk to each other. Decisions get made on anecdotes and whoever argues loudest.",
    },
    solution: {
      title: "Systems Integration & Data Visualization",
      description:
        "Connect internal systems and visualize the data that matters, so decisions get made on evidence, not opinion.",
    },
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0 2.77-.693a9 9 0 0 1 6.208.682l.108.054a9 9 0 0 0 6.086.71l3.114-.732a48.524 48.524 0 0 1-.005-10.499l-3.11.732a9 9 0 0 1-6.085-.711l-.108-.054a9 9 0 0 0-6.208-.682L3 4.5M3 15V4.5" />`,
    problem: {
      title: "Strategy Without an Operating Cadence",
      description:
        "The annual plan gets written, then ignored. Priorities drift, teams run their own plays, and nobody is accountable to the goals.",
    },
    solution: {
      title: "Operational Strategy & OKRs",
      description:
        "A seasoned OKR operator's playbook: clear objectives, measurable results, and a cadence that keeps every team pulling in the same direction.",
    },
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />`,
    problem: {
      title: "Generic Messaging, Blurry Positioning",
      description:
        "You sound like every other vendor. One message for every segment, persona, and stage, so it lands with no one.",
    },
    solution: {
      title: "Segmentation, Positioning & Brand Creative",
      description:
        "GTM segmentation, persona-level messaging, sharp positioning, and brand creative that make buyers instantly get why you're different.",
    },
  },
];

const problems = pairs.map((p, i) => ({ ...p.problem, icon: p.icon, num: String(i + 1).padStart(2, "0") }));
const solutions = pairs.map((p, i) => ({
  ...p.solution,
  icon: p.icon,
  num: String(i + 1).padStart(2, "0"),
  fixes: p.problem.title,
}));

// Full-funnel capabilities, top of funnel to post-sale. Widths echo the funnel motif.
const funnelStages = [
  {
    stage: "Create Demand",
    width: "lg:w-full",
    items: [
      "Awareness campaigns",
      "Product launches",
      "PPC, SEO & AEO",
      "Competitive intelligence",
    ],
  },
  {
    stage: "Capture & Convert",
    width: "lg:w-[85%]",
    items: [
      "Conversion offers",
      "Nurture tracks",
      "Calculators & interactive tools",
      "Marketing programs",
    ],
  },
  {
    stage: "Enable the Close",
    width: "lg:w-[70%]",
    items: [
      "Sales presentations",
      "Sales tools & training",
      "Custom materials",
      "Funnel velocity enhancement",
    ],
  },
  {
    stage: "Expand & Re-engage",
    width: "lg:w-[55%]",
    items: [
      "Customer expansion programs",
      "Closed-lost re-engagement",
      "Customer messaging",
      "Product prototypes",
    ],
  },
];

// Funnel-stage widths for the "How I Work" steps
const process = [
  {
    step: "01",
    title: "Understand",
    width: "w-full",
    description:
      "Audit your current GTM motion: market, customers, channels, team structure, and competitive landscape. Identify what's working, what's broken, and what's missing entirely.",
  },
  {
    step: "02",
    title: "Prioritize",
    width: "w-3/4",
    description:
      "Not everything needs fixing at once. Rank opportunities by impact, effort, and speed-to-pipeline. Pick the high-leverage moves that unlock the most value fastest.",
  },
  {
    step: "03",
    title: "Execute",
    width: "w-1/2",
    description:
      "Build and ship: messaging, campaigns, tools, processes. No 90-day strategy decks. Real work that hits the market and starts generating signal immediately.",
  },
  {
    step: "04",
    title: "Optimize",
    width: "w-1/4",
    description:
      "Measure what matters. Double down on what converts. Kill what doesn't. Continuously tighten the loop between spend, pipeline, and revenue.",
  },
];

const testimonials = [
  {
    quote:
      "What amazed me most about Stephen was his innate ability to always make the right decisions for the business. His decisions were always focused on producing the highest quality of leads even when it meant sacrificing his own goals. He scaled lead generation by over 500% and established a powerful marketing lead generation machine. Stephen is not the loudest person in the room but will make the most impact. Trust in his instincts, they won't disappoint.",
    name: "Ryan Dillon",
    title: "Head of Business Development, Thought Industries",
  },
  {
    quote:
      "He single-handedly brought our lead process and tracking up to date with current systems and approaches. He is smart, committed, persistent and metric-oriented. If you are looking to automate lead management, engage & nurture online users, and implement new technologies, Stephen is your guy.",
    name: "Theresa Delfino",
    title: "CMO, Aras Corp",
  },
  {
    quote:
      "When it comes to getting the job done — no matter how high the hurdle — Stephen is the person to turn to. He has not only helped drive real results for our largest territory, but has also become a well-respected and trusted partner to Sales. Stephen is creative, drives measurable results, and can diplomatically meet the needs of the most demanding salespeople. And that's a rare find.",
    name: "Michael Martin",
    title: "Director of Growth Marketing, Eloqua",
  },
  {
    quote:
      "When he came on board we were in desperate need for someone to run the Marketing team and he came in and made an impact from day one. He not only coordinated all key marketing functions professionally, but most importantly communicated and collaborated with our sales department. He developed a lead development program that supplied our team with much needed high quality MQLs. As demands increased he always hit his number.",
    name: "Nick Pederson",
    title: "Sales, Thought Industries",
  },
];

const facts = [
  {
    title: "Strengths",
    body: "Strategic thinking paired with tactical doing. I can set the plan at the leadership table, then go build the campaign, the dashboard, or the prototype myself.",
  },
  {
    title: "Working with CEOs",
    body: "Comfortable reporting directly to CEOs and founders. I've done it for most of my career.",
  },
  {
    title: "Working with Sales",
    body: "Marketing exists to create pipeline and help sellers close. I've managed BDR teams, built enablement tools and training, and shared a number with sales leadership.",
  },
  {
    title: "Working with Product",
    body: "I turn customer interest into working prototypes and roadmap-ready deliverables. As a founder I've shipped products end to end, so I speak the language.",
  },
  {
    title: "Leading teams",
    body: "I've been the first marketing hire and I've led 20+ person global teams with a $2.5M budget. Comfortable at either end and everywhere between.",
  },
  {
    title: "Roles by company stage",
    body: "First marketing hire at a 15-person company, VP at a PE-backed org, Head of Marketing for a global team, and a founder. I can operate in all of them.",
  },
  {
    title: "How I measure marketing",
    body: "Pipeline. Not traffic, not MQLs, not brand awards. Did we fill the funnel and help closers close.",
  },
  {
    title: "Decision making",
    body: "A combination of data-based analysis and my internal spidey sense.",
  },
  {
    title: "Weakness",
    body: "Boring interview questions.",
  },
  {
    title: "Education",
    body: "MBA in International Business from Liberty University, and a B.A. in Communications from Eastern Nazarene College.",
  },
  {
    title: "Why marketing",
    body: "It's a function that covers a lot of ground and has unlimited possibilities to create value for others.",
  },
  {
    title: "AI",
    body: "I use it every day. I built the site you're looking at in about 17 minutes with AI.",
  },
];

// Shipped proof for the claims above. Add more entries as links become available.
const work = [
  {
    tags: ["AI Application", "Product Prototyping", "AEO"],
    title: "Context Memo",
    description:
      "I built Context Memo, an AEO platform that publishes citation-grade content so brands get cited in ChatGPT and other AI answers. Product, positioning, and go-to-market, end to end.",
    proof:
      "Case study: 2,500+ sourced ChatGPT citations and attributed pipeline deals for a client in under 100 days.",
    links: [
      {
        text: "Read the Formula Inbox case study",
        href: "https://contextmemo.com/case-studies/formula-inbox",
      },
      { text: "contextmemo.com", href: "https://contextmemo.com" },
    ],
  },
];

const resumeUrl = "/Stephen-Newman-Resume-Aug-2026.pdf";

// Structured data for search engines and AI answer engines
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Stephen Newman",
  jobTitle: "GTM Executive & Growth Marketer",
  description:
    "GTM executive and growth marketer with 15+ years leading marketing, sales alignment, technology, and operational strategy for B2B SaaS companies. Track record includes multiple exits, acquisitions, and an IPO.",
  url: "https://www.stephennewman.me",
  image: "https://www.stephennewman.me/stephen_newman.jpeg",
  email: "mailto:stephen.p.newman@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Palm Harbor",
    addressRegion: "FL",
    addressCountry: "US",
  },
  sameAs: [
    "http://www.linkedin.com/in/stephennewman1",
    "https://contextmemo.com",
  ],
  worksFor: { "@type": "Organization", name: "Checkit" },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Liberty University" },
    { "@type": "CollegeOrUniversity", name: "Eastern Nazarene College" },
  ],
  knowsAbout: [
    "Go-to-market strategy",
    "Demand generation",
    "PPC",
    "SEO",
    "Answer engine optimization (AEO)",
    "Channel marketing mix",
    "Marketing operations",
    "OKRs",
    "Product prototyping",
    "Data visualization",
    "B2B SaaS marketing",
  ],
};

---

<Layout
  navLinks={[
    { text: "Problems", href: "#problems" },
    { text: "Solutions", href: "#solutions" },
    { text: "Process", href: "#process" },
    { text: "Work", href: "#work" },
    { text: "Results", href: "#results" },
    { text: "Experience", href: "#experience" },
  ]}
  ctaButton={{
    text: "Schedule Meeting",
    href: "https://calendly.com/stephen-krezzo/connect-with-stephen-30-mins",
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <!-- Hero -->
  <section class="relative pt-12 pb-24 md:pt-16 md:pb-32 overflow-hidden">
    <div class="max-w-5xl mx-auto px-6 relative">
      <div class="lg:grid lg:grid-cols-[1fr_14rem] lg:gap-16 lg:items-center">
        <div>
          <p
            class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-8"
          >
            GTM Executive & Growth Marketer
          </p>

          <h1
            class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tightest text-ink leading-none"
          >
            Fill the pipeline.<br />
            <span class="text-gradient">Enable the close.</span>
          </h1>

          <p class="max-w-2xl text-lg text-neutral mt-10 leading-relaxed">
            I build full-funnel GTM engines for B2B SaaS companies: awareness that
            fills the top, offers and nurture that move deals through the middle,
            and the tools and training that help closers close. Pipeline growth
            without extra overhead, and without the noise. 15+ years of
            experience. Four acquisitions. One IPO. Advanced AI operator.
          </p>

          <div class="mt-12 flex flex-wrap items-center gap-4">
            <a
              class="inline-block rounded-full bg-gradient px-8 py-4 text-sm font-medium text-[#fff] hover:opacity-90 transition-opacity"
              href="https://calendly.com/stephen-krezzo/connect-with-stephen-30-mins"
              target="_blank"
              rel="noopener noreferrer"
            >
              Schedule Meeting
            </a>
            <a
              class="inline-block rounded-full bg-ink px-8 py-4 text-sm font-medium text-[#fff] hover:bg-ink/80 transition-colors"
              href={resumeUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Download Resume
            </a>
          </div>
        </div>

        <div class="mt-16 lg:mt-0">
          <p
            class="text-xs uppercase tracking-[0.2em] text-neutral/50 font-medium mb-6"
          >
            Companies I've helped grow
          </p>
          <div
            class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-2 gap-x-8 gap-y-8 items-center"
          >
            <img
              src="/eloqua_logo.png"
              alt="Eloqua"
              class="h-8 w-auto object-contain brightness-0 opacity-40"
            />
            <img
              src="/aras_logo.png"
              alt="Aras"
              class="h-8 w-auto object-contain brightness-0 opacity-40"
            />
            <img
              src="/ti_logo.webp"
              alt="Thought Industries"
              class="h-7 w-auto object-contain brightness-0 opacity-40"
            />
            <img
              src="/form_logo.png"
              alt="Form.com"
              class="h-8 w-auto object-contain brightness-0 opacity-40"
            />
            <img
              src="/krezzo_logo.png"
              alt="Krezzo"
              class="h-7 w-auto object-contain brightness-0 opacity-40"
            />
            <img
              src="/checkit_logo.svg"
              alt="Checkit"
              class="h-6 w-auto object-contain brightness-0 opacity-40"
            />
            <img
              src="/d50_logo.webp"
              alt="D50 Media"
              class="h-7 w-auto object-contain brightness-0 opacity-40"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problems -->
  <section id="problems" class="py-24">
    <div class="max-w-5xl mx-auto px-6">
      <p
        class="text-sm uppercase tracking-[0.2em] text-rose-500 font-medium mb-4 reveal"
      >
        These will sound familiar
      </p>
      <h2
        class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-4 reveal"
      >
        Problems I Like Solving
      </h2>
      <p class="text-neutral max-w-2xl mb-16 reveal">
        Six failure modes I see over and over in B2B GTM. Each one maps
        directly to a solution below. Same number, same fix.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          problems.map((p) => (
            <div class="reveal bg-white border border-rose-200/80 rounded-2xl p-8 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300">
              <div class="flex items-center justify-between mb-4">
                <svg class="w-6 h-6 text-rose-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <Fragment set:html={p.icon} />
                </svg>
                <span class="text-xs font-mono text-rose-300 select-none">{p.num}</span>
              </div>
              <h3 class="text-lg font-bold text-ink mb-3">{p.title}</h3>
              <p class="text-sm text-neutral leading-relaxed">
                {p.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Solutions -->
  <section id="solutions" class="py-24 bg-gradient-to-br from-pink-50/70 via-white to-violet-50/70">
    <div class="max-w-5xl mx-auto px-6">
      <p
        class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-4 reveal"
      >
        What I bring
      </p>
      <h2
        class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-4 reveal"
      >
        Solutions I Provide
      </h2>
      <p class="text-neutral max-w-2xl mb-16 reveal">
        Mirrored one-to-one with the problems above. Strategy plus hands-on
        execution, not a deck and a handshake.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          solutions.map((s) => (
            <div class="reveal bg-white border border-violet-200/80 rounded-2xl p-8 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300">
              <div class="flex items-center justify-between mb-4">
                <svg class="w-6 h-6 text-violet-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <Fragment set:html={s.icon} />
                </svg>
                <span class="text-xs font-mono text-violet-300 select-none">{s.num}</span>
              </div>
              <h3 class="text-lg font-bold text-ink mb-3">{s.title}</h3>
              <p class="text-sm text-neutral leading-relaxed mb-4">
                {s.description}
              </p>
              <p class="text-xs text-neutral/60">
                Fixes: <span class="text-rose-400">{s.fixes}</span>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Across the Funnel -->
  <section id="funnel" class="py-24 bg-surface">
    <div class="max-w-5xl mx-auto px-6">
      <p
        class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-4 reveal"
      >
        Top to bottom
      </p>
      <h2
        class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-4 reveal"
      >
        Across the Funnel
      </h2>
      <p class="text-neutral max-w-2xl mb-16 reveal">
        Pipeline isn't one stage. I build programs at every layer, from first
        touch to closed-won and beyond.
      </p>

      <div class="flex flex-col items-center gap-4">
        {
          funnelStages.map((s, i) => (
            <div
              class={`reveal w-full ${s.width} bg-white border border-ink/5 rounded-2xl p-6 md:p-8 shadow-sm`}
            >
              <div class="flex items-center gap-3 mb-4">
                <span class="text-xs font-mono text-gradient select-none">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="text-lg font-bold text-ink">{s.stage}</h3>
              </div>
              <div class="flex flex-wrap gap-2">
                {s.items.map((item) => (
                  <span class="text-sm text-neutral bg-surface border border-ink/5 rounded-full px-4 py-1.5">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section id="process" class="py-24">
    <div class="max-w-5xl mx-auto px-6">
      <p
        class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-4 reveal"
      >
        The approach
      </p>
      <h2
        class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-16 reveal"
      >
        How I Work
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          process.map((p) => (
            <div class="relative reveal">
              <span class="text-6xl font-bold text-ink/5 font-serif absolute -top-4 -left-2 select-none">
                {p.step}
              </span>
              <div class="relative pt-8">
                <h3 class="text-xl font-bold text-ink mb-3">{p.title}</h3>
                <div class={`h-1.5 rounded-full bg-gradient mb-4 ${p.width}`} />
                <p class="text-sm text-neutral leading-relaxed">
                  {p.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Results -->
  <section id="results" class="py-24 bg-gradient-to-br from-violet-50/70 via-white to-pink-50/70">
    <div class="max-w-5xl mx-auto px-6">
      <p
        class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-4 reveal"
      >
        By the numbers
      </p>
      <h2
        class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-16 reveal"
      >
        Results
      </h2>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12 reveal">
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">15+</p>
          <p class="text-sm text-neutral mt-2">Years in B2B SaaS</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">4</p>
          <p class="text-sm text-neutral mt-2">Acquisitions & exits</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight whitespace-nowrap">$100M+</p>
          <p class="text-sm text-neutral mt-2">Pipeline generated</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">25x</p>
          <p class="text-sm text-neutral mt-2">Lead gen growth</p>
        </div>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12 mt-12 pt-12 border-t border-ink/10 reveal">
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">$5M+</p>
          <p class="text-sm text-neutral mt-2">Pipeline in 6 months</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">$2.5M</p>
          <p class="text-sm text-neutral mt-2">Budget managed</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">80%</p>
          <p class="text-sm text-neutral mt-2">Revenue from inbound</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl font-bold text-gradient font-serif tracking-tight">$500K+</p>
          <p class="text-sm text-neutral mt-2">Raised as founder</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <Experience />

  <!-- Social Proof -->
  <section id="testimonials" class="py-24 bg-surface">
    <div class="max-w-5xl mx-auto px-6">
      <p
        class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-4 reveal"
      >
        What others say
      </p>
      <h2
        class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-16 reveal"
      >
        Don't Take My Word For It
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          testimonials.map((t) => (
            <div class="reveal bg-white border border-ink/5 rounded-2xl p-8">
              <svg
                class="w-8 h-8 text-ink/10 mb-4"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983z" />
              </svg>
              <p class="text-neutral text-sm leading-relaxed mb-6 italic">
                "{t.quote}"
              </p>
              <div>
                <p class="text-ink font-medium text-sm">{t.name}</p>
                <p class="text-neutral/60 text-xs">{t.title}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured Project -->
  <section id="work" class="py-24 bg-gradient-to-br from-pink-50/70 via-white to-violet-50/70">
    <div class="max-w-5xl mx-auto px-6">
      <p
        class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-4 reveal"
      >
        Proof, not promises
      </p>
      <h2
        class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-4 reveal"
      >
        Featured Project
      </h2>
      <p class="text-neutral max-w-2xl mb-16 reveal">
        Things I've built and shipped, not just managed.
      </p>

      <div class="grid grid-cols-1 gap-6">
        {
          work.map((w) => (
            <div class="reveal bg-white border border-ink/5 rounded-2xl p-8 md:p-10 shadow-sm">
              <div class="flex flex-wrap gap-2 mb-5">
                {w.tags.map((tag) => (
                  <span class="text-xs font-medium uppercase tracking-wider text-violet-600 bg-violet-50 border border-violet-200/70 rounded-full px-3 py-1">
                    {tag}
                  </span>
                ))}
              </div>
              <h3 class="font-serif text-2xl font-bold text-ink mb-3">
                {w.title}
              </h3>
              <p class="text-neutral leading-relaxed mb-3 max-w-3xl">
                {w.description}
              </p>
              <p class="text-sm text-ink font-medium mb-6">{w.proof}</p>
              <div class="flex flex-wrap gap-4">
                {w.links.map((link, i) => (
                  <a
                    class={
                      i === 0
                        ? "inline-block rounded-full bg-gradient px-6 py-3 text-sm font-medium text-[#fff] hover:opacity-90 transition-opacity"
                        : "inline-block rounded-full border border-ink/15 px-6 py-3 text-sm font-medium text-ink hover:border-ink/40 transition-colors"
                    }
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.text}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Good to Know -->
  <section id="faq" class="py-24">
    <div class="max-w-5xl mx-auto px-6">
      <p
        class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-4 reveal"
      >
        For the record
      </p>
      <h2
        class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-16 reveal"
      >
        Good to Know
      </h2>

      <div class="space-y-0 border-t border-ink/10 reveal">
        {
          facts.map((f) => (
            <div class="grid md:grid-cols-[14rem_1fr] gap-1 md:gap-8 border-b border-ink/10 py-6">
              <p class="text-ink font-medium text-lg">{f.title}</p>
              <p class="text-neutral leading-relaxed">{f.body}</p>
