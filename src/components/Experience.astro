---
import { SITE_CONTENT } from "../config/index.ts";

const experience = SITE_CONTENT.experience;
---

<section id="experience" class="py-24">
  <div class="max-w-5xl mx-auto px-6">
    <p
      class="text-sm uppercase tracking-[0.2em] text-gradient font-medium mb-4 reveal"
    >
      Where I've been
    </p>
    <h2
      class="font-serif text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-16 reveal"
    >
      Experience
    </h2>

    <div>
      {
        experience.map((role) => (
          <div class="relative pl-16 pb-12 last:pb-0 border-l border-ink/10 reveal">
            <div class="absolute left-0 top-0 -translate-x-1/2 w-10 h-10 rounded-full bg-white border border-ink/10 flex items-center justify-center">
              <img
                src={role.logo}
                alt=""
                class="max-h-5 max-w-6 object-contain brightness-0 opacity-60"
              />
            </div>

            <div class="flex flex-col md:flex-row md:items-baseline md:gap-4 mb-1">
              <h3 class="text-xl font-bold text-ink font-serif">
                {role.company}
              </h3>
              <span class="text-sm text-neutral/60">{role.location}</span>
            </div>

            <div class="flex flex-col md:flex-row md:items-baseline md:gap-4 mb-4">
              <p class="text-gradient font-medium">{role.position}</p>
              <span class="text-sm text-neutral font-mono">
                {role.startDate} – {role.endDate}
              </span>
            </div>

            {Array.isArray(role.summary) ? (
              <ul class="space-y-2">
                {role.summary.map((s) => (
                  <li class="text-neutral text-base leading-relaxed">{s}</li>
                ))}
              </ul>
            ) : (
              <p class="text-neutral text-base leading-relaxed">
                {role.summary}
              </p>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
